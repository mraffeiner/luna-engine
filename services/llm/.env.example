# Set the providers you want to use. A provider without its key is skipped.

# OpenAI
OPENAI_API_KEY=

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini (OpenAI-compatible endpoint)
GEMINI_API_KEY=
GOOGLE_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Local OpenAI-compatible server on the host (Ollama, LM Studio, llama.cpp, ...). Keep one line active.
# Ollama:
LOCAL_BASE_URL=http://host.docker.internal:11434/v1
# LM Studio:
# LOCAL_BASE_URL=http://host.docker.internal:1234/v1
