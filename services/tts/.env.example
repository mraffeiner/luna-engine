# Azure Speech (optional). Azure is disabled unless both values are set.
AZURE_SUBSCRIPTION=
AZURE_ENDPOINT=

# Local engines (optional overrides; the defaults match the root docker-compose.yml)
# KOKORO_API_URL=http://kokoro-tts:8880
# SESAME_API_URL=http://sesame-tts:8000

# --- Read by the kokoro-tts / sesame-tts containers, not by tts-service ---
# Hugging Face token, needed by sesame-tts to download the gated CSM-1B model
HF_TOKEN=
# Kokoro-FastAPI settings (its GPU image already defaults to these)
# USE_GPU=true
# PYTHONUNBUFFERED=1
# PYTHONPATH=/app:/app/api
