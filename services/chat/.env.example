# --- Twitch ---
# OAuth token for the bot account (the "oauth:" prefix is optional)
TWITCH_OAUTH_TOKEN=
TWITCH_CLIENT_ID=
TWITCH_NICK=
# Comma-separated list of channels to join
TWITCH_CHANNELS=

# --- YouTube ---
# Channel whose live chat should be read (starts with UC...)
YOUTUBE_CHANNEL_ID=
# Also requires youtube_secret.json (Google OAuth client) in this repo's root. See README.

# --- Optional overrides (defaults shown) ---
# GOOGLE_CLIENT_SECRETS_FILE=/app/youtube_secret.json
# GOOGLE_CREDENTIALS_STORE_DIR=/app/credentials
# OAUTH_REDIRECT_URI=http://localhost:8005/oauth2callback
